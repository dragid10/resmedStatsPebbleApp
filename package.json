{
  "name": "resmedStatsPebbleApp",
  "author": "dragid10",
  "license": "MIT",
  "version": "1.3.0",
  "keywords": ["pebble-app"],
  "private": true,
  "scripts": {
    "test": "node --test test/pkjs/*.test.js && sh test/c/run.sh"
  },
  "dependencies": {
    "@rebble/clay": "^1.0.8"
  },
  "pebble": {
    "displayName": "ResMed Stats",
    "uuid": "d607a5ed-bb8b-41ee-ace2-10db69f73b46",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "capabilities": [
      "configurable"
    ],
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "myair.resmed.com",
            "resmed-ext-1.okta.com",
            "static.myair-prd.dht.live",
            "myair.resmed.eu",
            "id.resmed.eu",
            "hyperdrive.resmed.eu"
          ]
        },
        "reason": "To sign in to myAir and get your sleep stats",
        "required": true
      }
    ],
    "plugin": {
      "description": "CPAP sleep stats from ResMed myAir, as fetched by the ResMed Stats app: one instance per night, newest first (instances[0] is last night), with sleep score (0-100), AHI (events an hour), usage (minutes), mask-off count and leak (%). Updated when the ResMed Stats app syncs, about once a day.",
      "script": "src/plugin/index.js",
      "definesPermissions": [
        {
          "name": "ReadSleepStats",
          "label": "Read your CPAP sleep stats",
          "kind": "read"
        }
      ],
      "sources": [
        {
          "category": "health",
          "items": ["cpap"],
          "properties": {
            "name": ["shortText", "longText"],
            "night": ["timestamp"],
            "sleep_score": ["numericValue", "shortText", "longText"],
            "ahi": ["numericValue", "shortText", "longText"],
            "usage": ["numericValue", "shortText", "longText"],
            "mask_off": ["numericValue", "shortText", "longText"],
            "leak": ["numericValue", "shortText", "longText"]
          },
          "supportsMultiple": true,
          "callerPermissions": ["ReadSleepStats"],
          "suggestedRefreshIntervalSec": 3600
        }
      ]
    },
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "REQUEST_DATA",
      "DAY_INDEX",
      "RECORD_DATE",
      "SLEEP_SCORE",
      "AHI_X10",
      "USAGE_MINS",
      "MASK_COUNT",
      "LEAK_PCT",
      "TOTAL_DAYS",
      "DATA_COMPLETE",
      "ERROR_MSG",
      "FRESH_INSTALL",
      "COLORBLIND_MODE",
      "SYNC_INTERVAL",
      "SHOW_EVENTS",
      "SHOW_USAGE",
      "SHOW_MASK_OFF",
      "SHOW_LEAK",
      "TEXT_INDICATORS",
      "LOGGING_IN"
    ],
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "IMAGE_MENU_ICON",
          "file": "icon_25x25.png",
          "menuIcon": true
        }
      ]
    }
  }
}
